---
import BaseLayout from './BaseLayout.astro';

interface Props {
    title: string;
    intro: string;
}

const { title, intro } = Astro.props;
---

<BaseLayout title={title}>
    <article class="content-page">
        <header>
            <h1>{title}</h1>
            <p>{intro}</p>
        </header>
        <div class="content">
            <slot />
        </div>
    </article>
</BaseLayout>

<style>
    .content-page {
        width: min(100%, 70rem);
        min-height: calc(100svh - 5rem);
        margin: 0 auto;
        padding: clamp(5rem, 12vw, 10rem) clamp(1rem, 8vw, 8rem);
    }

    header {
        max-width: 48rem;
    }

    h1 {
        margin: 0;
        font-family: "Fraunces", serif;
        font-size: clamp(3rem, 7vw, 6.5rem);
        font-weight: 400;
        line-height: 1;
        letter-spacing: -0.035em;
    }

    header > p {
        margin: 1.5rem 0 0;
        font-size: clamp(1.1rem, 2vw, 1.35rem);
    }

    .content {
        max-width: 44rem;
        margin-top: clamp(3rem, 8vw, 6rem);
    }
</style>
