---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Kambô">
    <article class="kambo-page">
        <header class="kambo-intro">
            <p class="eyebrow">Körper & Ritual</p>
            <h1>Kambô</h1>
        </header>

        <section class="kambo-section personal-connection" aria-labelledby="connection-heading">
            <p class="section-number">01</p>
            <h2 id="connection-heading">Meine Verbindung zu Kambô</h2>
        </section>

        <section class="kambo-section" aria-labelledby="space-heading">
            <p class="section-number">02</p>
            <h2 id="space-heading">Der Raum</h2>
        </section>

        <section class="kambo-section" aria-labelledby="process-heading">
            <p class="section-number">03</p>
            <h2 id="process-heading">Ablauf & Orientierung</h2>
        </section>

        <section class="kambo-section important-notes" aria-labelledby="notes-heading">
            <p class="section-number">04</p>
            <h2 id="notes-heading">Wichtige Hinweise</h2>
        </section>

        <section class="kambo-section contact" aria-labelledby="contact-heading">
            <p class="section-number">05</p>
            <h2 id="contact-heading">Anfrage</h2>
        </section>
    </article>
</BaseLayout>

<style>
    .kambo-page {
        width: min(100%, 70rem);
        margin: 0 auto;
        padding: clamp(5rem, 12vw, 10rem) clamp(1rem, 8vw, 8rem);
    }

    .kambo-intro {
        min-height: min(45vw, 28rem);
    }

    .eyebrow,
    .section-number {
        margin: 0;
        color: #3e5c58;
        font-size: 0.8rem;
        font-weight: 500;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    h1,
    h2 {
        color: #232b24;
        font-family: "Fraunces", serif;
        font-weight: 400;
        letter-spacing: -0.04em;
    }

    h1 {
        max-width: 10ch;
        margin: 1rem 0 0;
        font-size: clamp(3rem, 7vw, 6.5rem);
        line-height: 1;
    }

    .kambo-section {
        display: grid;
        grid-template-columns: minmax(4rem, 12rem) minmax(0, 1fr);
        gap: clamp(1.5rem, 6vw, 7rem);
        min-height: clamp(12rem, 22vw, 17rem);
        padding: clamp(2rem, 5vw, 4rem) 0;
        border-top: 1px solid rgb(35 43 36 / 0.16);
    }

    .kambo-section h2 {
        max-width: 14ch;
        margin: 0;
        font-size: clamp(2rem, 4.5vw, 4rem);
        line-height: 1;
    }

    .personal-connection {
        border-top-color: #c97b5a;
    }

    .important-notes {
        color: #f4efe6;
    }

    .important-notes h2,
    .important-notes .section-number {
        color: inherit;
    }

    .important-notes {
        margin-right: clamp(-8rem, -8vw, -1rem);
        margin-left: clamp(-8rem, -8vw, -1rem);
        padding-right: clamp(1rem, 8vw, 8rem);
        padding-left: clamp(1rem, 8vw, 8rem);
        border-top: 0;
        background: #3e5c58;
    }

    .contact {
        border-top-color: #c97b5a;
    }

    @media (max-width: 40rem) {
        .kambo-intro {
            min-height: 17rem;
        }

        .kambo-section {
            grid-template-columns: 1fr;
            gap: 1rem;
            min-height: 11rem;
        }
    }
</style>
